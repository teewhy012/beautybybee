# Stripe API keys — get from https://dashboard.stripe.com/apikeys
# Use the sk_test_ key for development, sk_live_ for production.
# Leave commented out to run the site without live payment (checkout will show a friendly notice).
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Optional: webhook secret for handling payment events (recommended for production sync).
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here